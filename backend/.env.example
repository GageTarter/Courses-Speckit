DB_HOST=localhost
# Defaults to 3306. XAMPP on macOS often listens on 3307 — check Manager → MySQL.
DB_PORT=3306
DB_USER=root
DB_PW=
DB_NAME=courses-db
AUTH_SECRET=change-me-in-production
PORT=3200
NODE_ENV=development
# In development, schema changes auto-apply on server start (set false to disable).
SEQUELIZE_SYNC_ALTER=true
